model Establishment{
  id          String    @id @default(uuid())
  name        String
  owner       String
  email       String    @unique
  phone       String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  website     String?
  location    String?
}

model Owner{
  id          String    @id @default(uuid())
  name        String
  cpf         String    @unique
  phone       String
  email       String
  password    String
}

model Service{
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    Int //duration in minutes
}

model Client{
  id          String    @id @default(uuid())
  name        String
  cpf         String    @unique
  phone       String
  email       String
}

model Appointment{
 id           String    @id @default(uuid())
 data         DateTime //hora ta inclusa aqui
 status       Boolean @default(false)
 createdAt TimestamptzString @default(now())
}

