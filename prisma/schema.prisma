generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Establishment {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  website     String?
  location    String?

  ownerId     String
  owner       Owner     @relation(fields: [ownerId], references: [id])

  services Service[]
  businessHours BusinessHour[]
}


//dessa forma consigo controlar os horários de funcionamento do estabelecimento
model BusinessHour {
  id             String @id @default(uuid())

  establishmentId String
  establishment Establishment @relation(fields: [establishmentId], references: [id])

  dayOfWeek      Int
  openingTime    String
  closingTime    String
}

model Owner {
  id          String    @id @default(uuid())
  name        String
  cpf         String    @unique
  phone       String
  email       String    @unique
  password    String

  establishments Establishment[]
}

model Service {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    Int //duration in minutes

  establishmentId String
  establishment Establishment @relation(fields: [establishmentId], references: [id])
}

model Client {
  id          String    @id @default(uuid())
  name        String
  cpf         String    @unique
  phone       String
  email       String
}

model Appointment {
 id           String    @id @default(uuid())
 data         DateTime  //hora ta inclusa aqui
 status       Boolean   @default(false)
 createdAt    DateTime  @default(now())
}
